<core:FlowControl x:Class="Flow.Component.Controls.RoundedButton"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:core="clr-namespace:Flow.Core;assembly=Flow.Core"
                  xmlns:local="clr-namespace:Flow.Component.Controls">
    <core:FlowControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Flow.Component;component/Styles/ButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:FlowControl.Resources>
    <Border Background="Transparent">
        <Button Style="{StaticResource RoundedButtonStyle}"
                Content="{Binding Text, RelativeSource={RelativeSource AncestorType=core:FlowControl}}"
                IsHitTestVisible="False" />
    </Border>
</core:FlowControl>
