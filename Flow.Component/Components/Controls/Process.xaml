<core:FlowControl x:Class="Flow.Component.Controls.Process"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:core="clr-namespace:Flow.Core;assembly=Flow.Core"
                  xmlns:local="clr-namespace:Flow.Component.Controls">
    <core:FlowControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Flow.Component;component/Styles/FlowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:FlowControl.Resources>
    <Grid>
        <Border Style="{StaticResource ProcessNodeBorderStyle}">
        <TextBox x:Name="ProcessTextBox"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=core:FlowControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ProcessTextBoxStyle}"
                 PreviewMouseDoubleClick="ProcessTextBox_PreviewMouseDoubleClick" />
        </Border>
        <Ellipse x:Name="InputConnector"
                 Style="{StaticResource ConnectorDotStyle}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="-5,0,0,0"
                 PreviewMouseRightButtonDown="Connector_OnPreviewMouseRightButtonDown" />
        <Ellipse x:Name="OutputConnector"
                 Style="{StaticResource ConnectorDotStyle}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="0,0,-5,0"
                 PreviewMouseRightButtonDown="Connector_OnPreviewMouseRightButtonDown" />
    </Grid>
</core:FlowControl>
