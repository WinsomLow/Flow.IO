<Window x:Class="Flow.Drafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flow.Drafter"
        mc:Ignorable="d"
        Title="Flow.IO" Height="800" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Background="#FFF2F4F7"
                BorderBrush="#FFD7DCE3"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <Button Height="20" Margin="10 10 10 10" DockPanel.Dock="Bottom">Load</Button>
                <Button Height="20" Margin="10 10 10 10" DockPanel.Dock="Bottom">Save</Button>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Flow Blocks"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                    <ListBox x:Name="FlowBlockList"
                         BorderThickness="0"
                         Background="Transparent"
                         PreviewMouseMove="FlowBlockList_OnPreviewMouseMove">
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Column="1"
                Background="White"
                BorderBrush="#FFE3E6EA"
                BorderThickness="1">
            <Canvas x:Name="DesignCanvas"
                    Background="Transparent"
                    AllowDrop="True"
                    DragOver="DesignCanvas_OnDragOver"
                    Drop="DesignCanvas_OnDrop" />
        </Border>
    </Grid>
</Window>
