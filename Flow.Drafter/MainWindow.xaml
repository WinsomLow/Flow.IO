<Window x:Class="Flow.Drafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flow.Drafter"
        mc:Ignorable="d"
        Title="Flow.IO" Height="800" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Style="{StaticResource SidebarBorderStyle}">
            <DockPanel Margin="12">
                <Button Style="{StaticResource SidebarActionButtonStyle}"
                        DockPanel.Dock="Bottom">Load</Button>
                <Button Style="{StaticResource SidebarActionButtonStyle}"
                        DockPanel.Dock="Bottom">Save</Button>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Flow Blocks"
                               Style="{StaticResource SectionHeaderTextStyle}" />
                    <ListBox x:Name="FlowBlockList"
                             Style="{StaticResource FlowBlockListStyle}"
                             PreviewMouseMove="FlowBlockList_OnPreviewMouseMove">
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Column="1"
                Style="{StaticResource CanvasBorderStyle}">
            <Canvas x:Name="DesignCanvas"
                    Style="{StaticResource DesignCanvasStyle}"
                    DragOver="DesignCanvas_OnDragOver"
                    Drop="DesignCanvas_OnDrop" />
        </Border>
    </Grid>
</Window>
